{
  "name": "pebble-kite",
  "author": "James Downs",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "prettier:write": "npx prettier . --write"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.2",
    "@babel/runtime-corejs3": "^7.28.2",
    "core-js": "^3.44.0",
    "pebble-clay": "^1.0.4",
    "pebble-events": "1.2.0",
    "pebble-packet": "^1.2.0",
    "qrcode-generator": "^2.0.4",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "babel-plugin-transform-async-to-promises": "^0.8.18",
    "prettier": "3.6.2",
    "rollup": "^4.46.2",
    "rollup-plugin-string": "^3.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "pebble": {
    "displayName": "Kagi News",
    "uuid": "6c447caf-fdc4-4e75-b043-088b127f2b5a",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "diorite"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": [
      "UserCategories",
      "type",
      "state",
      "data",
      "data1",
      "data2",
      "data3",
      "data4",
      "error",
      "page",
      "nextPage",
      "batchId",
      "categoryName",
      "shortData",
      "storyTitle",
      "isShortTitle",
      "url",
      "chunk",
      "nextChunk",
      "storyId",
      "detailType",
      "articleDomain",
      "detailKey",
      "qrSize"
    ],
    "resources": {
      "media": [
        {
          "file": "icons/menu_icon.png",
          "menuIcon": true,
          "name": "IMAGE_MENU_ICON",
          "type": "bitmap"
        },
        {
          "file": "icons/kagi_news_25x25.png",
          "name": "IMAGE_KAGI_NEWS_25",
          "type": "bitmap"
        },
        {
          "file": "icons/kagi_doggo_80x80.png",
          "name": "IMAGE_KAGI_DOGGO_80",
          "type": "bitmap"
        },
        {
          "type": "font",
          "name": "FONT_LUFGA_BLACK_20",
          "file": "fonts/lufga-black.ttf"
        },
        {
          "type": "font",
          "name": "FONT_LUFGA_REGULAR_18",
          "file": "fonts/lufga-regular.ttf"
        }
      ]
    }
  }
}
